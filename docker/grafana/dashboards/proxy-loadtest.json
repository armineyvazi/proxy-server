          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(loadtest_requests_total{job=\"$job\",code=~\"5..\"}[$__rate_interval]) / rate(loadtest_requests_total{job=\"$job\"}[$__rate_interval]) * 100",
          "legendFormat": "5xx errors",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(loadtest_requests_total{job=\"$job\",code=~\"4..\"}[$__rate_interval]) / rate(loadtest_requests_total{job=\"$job\"}[$__rate_interval]) * 100",
          "legendFormat": "4xx errors",
          "refId": "C"
