{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Proxy system benchmarking — select instance(s) with $instance variable",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "title": "System Overview", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }, "unit": "percent" }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "title": "CPU Busy % — $instance",
      "type": "gauge",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (avg by(instance)(irate(node_cpu_seconds_total{job=\"node_exporter\",mode=\"idle\",instance=~\"$instance\"}[$__rate_interval])) * 100)", "legendFormat": "{{instance}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }, "unit": "percent" }
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "title": "Memory Used % — $instance",
      "type": "gauge",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (node_memory_MemAvailable_bytes{job=\"node_exporter\",instance=~\"$instance\"} / node_memory_MemTotal_bytes{job=\"node_exporter\",instance=~\"$instance\"} * 100)", "legendFormat": "{{instance}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "short" } },
      "gridPos": { "h": 2, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Load Avg 1m",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_load1{job=\"node_exporter\",instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "short" } },
      "gridPos": { "h": 2, "w": 6, "x": 12, "y": 3 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Load Avg 5m",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_load5{job=\"node_exporter\",instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "bytes" } },
      "gridPos": { "h": 2, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Memory Available",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_memory_MemAvailable_bytes{job=\"node_exporter\",instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }, "unit": "bytes" } },
      "gridPos": { "h": 2, "w": 6, "x": 18, "y": 3 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Memory Total",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_memory_MemTotal_bytes{job=\"node_exporter\",instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "id": 101, "title": "CPU & Memory", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" }, "unit": "percent" }
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "id": 10,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg by(instance)(irate(node_cpu_seconds_total{job=\"node_exporter\",mode=\"user\",instance=~\"$instance\"}[$__rate_interval])) * 100",   "legendFormat": "{{instance}} user",   "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg by(instance)(irate(node_cpu_seconds_total{job=\"node_exporter\",mode=\"system\",instance=~\"$instance\"}[$__rate_interval])) * 100", "legendFormat": "{{instance}} system", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg by(instance)(irate(node_cpu_seconds_total{job=\"node_exporter\",mode=\"iowait\",instance=~\"$instance\"}[$__rate_interval])) * 100", "legendFormat": "{{instance}} iowait", "refId": "C" }
      ],
      "title": "CPU Usage by Mode (all selected instances)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "stacking": { "group": "A", "mode": "normal" } }, "unit": "bytes" }
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "id": 11,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_memory_MemTotal_bytes{job=\"node_exporter\",instance=~\"$instance\"} - node_memory_MemFree_bytes{job=\"node_exporter\",instance=~\"$instance\"} - node_memory_Buffers_bytes{job=\"node_exporter\",instance=~\"$instance\"} - node_memory_Cached_bytes{job=\"node_exporter\",instance=~\"$instance\"}", "legendFormat": "{{instance}} used",          "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_memory_Cached_bytes{job=\"node_exporter\",instance=~\"$instance\"} + node_memory_Buffers_bytes{job=\"node_exporter\",instance=~\"$instance\"}",                                                                                                                                                                                           "legendFormat": "{{instance}} cache+buf",      "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_memory_MemFree_bytes{job=\"node_exporter\",instance=~\"$instance\"}",                                                                                                                                                                                                                                                                          "legendFormat": "{{instance}} free",          "refId": "C" }
      ],
      "title": "Memory Breakdown (all selected instances)",
      "type": "timeseries"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }, "id": 102, "title": "Network — Proxy Traffic", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" }, "unit": "Bps" },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".* tx" }, "properties": [{ "id": "custom.transform", "value": "negative-Y" }] }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "id": 20,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance)(irate(node_network_receive_bytes_total{job=\"node_exporter\",instance=~\"$instance\",device!~\"lo|docker.*|br-.*|veth.*\"}[$__rate_interval]))",  "legendFormat": "{{instance}} rx", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance)(irate(node_network_transmit_bytes_total{job=\"node_exporter\",instance=~\"$instance\",device!~\"lo|docker.*|br-.*|veth.*\"}[$__rate_interval]))", "legendFormat": "{{instance}} tx", "refId": "B" }
      ],
      "title": "Network Throughput — RX up / TX down (all instances)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" }, "unit": "pps" },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".* tx" }, "properties": [{ "id": "custom.transform", "value": "negative-Y" }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 21,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance)(irate(node_network_receive_packets_total{job=\"node_exporter\",instance=~\"$instance\",device!~\"lo|docker.*|br-.*|veth.*\"}[$__rate_interval]))",  "legendFormat": "{{instance}} rx", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance)(irate(node_network_transmit_packets_total{job=\"node_exporter\",instance=~\"$instance\",device!~\"lo|docker.*|br-.*|veth.*\"}[$__rate_interval]))", "legendFormat": "{{instance}} tx", "refId": "B" }
      ],
      "title": "Network Packets / Second",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 22,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_sockstat_TCP_inuse{job=\"node_exporter\",instance=~\"$instance\"}",  "legendFormat": "{{instance}} TCP InUse",     "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_sockstat_TCP_tw{job=\"node_exporter\",instance=~\"$instance\"}",     "legendFormat": "{{instance}} TIME_WAIT",     "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_netstat_Tcp_CurrEstab{job=\"node_exporter\",instance=~\"$instance\"}", "legendFormat": "{{instance}} ESTABLISHED", "refId": "C" }
      ],
      "title": "TCP Connections (all instances)",
      "type": "timeseries"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "id": 103, "title": "Context Switches & Interrupts", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" }, "unit": "ops" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "id": 30,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "irate(node_context_switches_total{job=\"node_exporter\",instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "{{instance}} ctx-switches", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "irate(node_intr_total{job=\"node_exporter\",instance=~\"$instance\"}[$__rate_interval])",            "legendFormat": "{{instance}} interrupts",   "refId": "B" }
      ],
      "title": "Context Switches & Interrupts / Second",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 31,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_sockstat_sockets_used{job=\"node_exporter\",instance=~\"$instance\"}", "legendFormat": "{{instance}} sockets used", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_filefd_allocated{job=\"node_exporter\",instance=~\"$instance\"}",      "legendFormat": "{{instance}} fds open",     "refId": "B" }
      ],
      "title": "File Descriptors & Socket Usage",
      "type": "timeseries"
    }

  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["proxy", "benchmark", "system"],
  "templating": {
    "list": [
      { "current": {}, "hide": 0, "includeAll": false, "label": "Datasource", "multi": false, "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "type": "datasource" },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(node_cpu_seconds_total{job=\"node_exporter\"}, instance)",
        "hide": 0,
        "includeAll": true,
        "allValue": "rust-proxy-server|nginx-proxy",
        "label": "Instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": { "query": "label_values(node_cpu_seconds_total{job=\"node_exporter\"}, instance)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "rust-proxy-server|nginx-proxy",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Proxy Benchmark — System Resources",
  "uid": "proxy-benchmark-v1",
  "version": 2
}
