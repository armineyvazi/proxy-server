---
# nginx VM: nginx reverse proxy + node-exporter.
# Upstream is at {{ upstream_nginx_ip }}:9000

services:

  nginx:
    image: nginx:1.27-alpine
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./proxy.conf:/etc/nginx/conf.d/proxy.conf:ro
    ports:
      - "80:8080"
    restart: unless-stopped
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576

  node-exporter:
    image: prom/node-exporter:v1.8.2
    pid: host
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - '--path.procfs=/host/proc'
      - '--path.sysfs=/host/sys'
      - '--path.rootfs=/rootfs'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
      - '--collector.systemd'
    ports:
      - "9100:9100"
    restart: unless-stopped
