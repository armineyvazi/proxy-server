# Nginx configured as HTTP/1.1 reverse proxy — mirroring proxy-server's role.
# Key choices:
#   proxy_http_version 1.1 + keepalive 64  → upstream connection pool (unlike
#   proxy-server which opens a new TCP per request). This makes nginx faster
#   in throughput benchmarks. The Grafana CPU graph will show the difference.

upstream benchmark_backend {
    server {{ upstream_host }}:{{ upstream_port }};
    keepalive 64;          # pool of 64 idle connections to upstream
    keepalive_timeout 60s;
}

server {
    listen {{ proxy_port }};
    server_name _;

    access_log off;        # disable access log to reduce I/O during benchmarks
    error_log /var/log/nginx/proxy-error.log warn;

    location / {
        proxy_pass         http://benchmark_backend;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";           # enable keep-alive to upstream
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;

        proxy_connect_timeout  5s;
        proxy_read_timeout    30s;
        proxy_send_timeout    30s;

        proxy_buffering    off;   # stream response immediately, no buffering
    }
}
